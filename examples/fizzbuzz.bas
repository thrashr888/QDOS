10 REM FIZZBUZZ
20 PRINT "FIZZBUZZ 1 TO 30:"
30 PRINT
40 FOR N = 1 TO 30
50   LET F = 0
60   LET M = N - INT(N/3)*3
70   IF M <> 0 THEN 90
80   PRINT "FIZZ";
85   LET F = 1
90   LET M = N - INT(N/5)*5
100  IF M <> 0 THEN 120
110  PRINT "BUZZ";
115  LET F = 1
120  IF F <> 0 THEN 140
130  PRINT N;
140  PRINT
150 NEXT N
160 END
